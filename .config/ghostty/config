font-family = "Geist Mono"
font-feature = -calt, -liga, -dlig
font-size = 11

foreground = f2f3f4
background = 020304

cursor-color = 3090f0
cursor-style = bar
cursor-style-blink = true
cursor-text = 020304

palette-generate = true
palette = 0=a4a5a6
palette = 1=e25099
palette = 2=62c073
palette = 3=e0a278
palette = 4=6969f9
palette = 5=a658f5
palette = 6=4aacc0
palette = 7=f2f3f4
palette = 8=a4a5a6
palette = 9=e25099
palette = 10=62c073
palette = 11=e0a278
palette = 12=6969f9
palette = 13=a658f5
palette = 14=4aacc0
palette = 15=f2f3f4

selection-foreground = 020304
selection-background = f2f3f4
selection-clear-on-copy = true

search-foreground = 020304
search-background = f2f3f4
search-selected-foreground = 020304
search-selected-background = 3090f0

mouse-hide-while-typing = true
scrollbar = never

window-padding-x = 6
window-padding-y = 3
window-padding-balance = true
window-padding-color = extend
window-decoration = server

resize-overlay = never
right-click-action = ignore

bell-features = no-system, no-audio, no-attention, no-title, border
app-notifications = no-clipboard-copy, no-config-reload

shell-integration = zsh
shell-integration-features = cursor, sudo, title, path

quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m

confirm-close-surface = false

keybind = clear

keybind = ctrl++=increase_font_size:1
keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+a=select_all

keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom