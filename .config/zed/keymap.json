[
  {
    "context": "vim_mode == normal || vim_mode == visual || vim_mode == operator",
    "bindings": {
      "w": "vim::Up",
      "a": "vim::Left",
      "s": "vim::Down",
      "d": "vim::Right",
      "i": "vim::PreviousLineStart",
      "j": "vim::StartOfLineDownward",
      "k": "vim::NextLineStart",
      "l": "vim::EndOfLineDownward",
      "b": "vim::NextSubwordStart",
      "q": "vim::NextSubwordEnd",
      "shift-b": "vim::PreviousSubwordStart",
      "shift-q": "vim::PreviousSubwordEnd",
      "1": ["vim::Number", 1],
      "2": ["vim::Number", 2],
      "3": ["vim::Number", 3],
      "4": ["vim::Number", 4],
      "5": ["vim::Number", 5],
      "6": ["vim::Number", 6],
      "7": ["vim::Number", 7],
      "8": ["vim::Number", 8],
      "9": ["vim::Number", 9],
      "0": ["vim::Number", 0],
      "%": "vim::GoToPercentage",
      "alt-q": "vim::Repeat"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "enter": "vim::InsertLineBelow",
      "shift-enter": "vim::InsertLineAbove",
      "r": "vim::InsertBefore",
      "shift-r": "vim::InsertFirstNonWhitespace",
      "e": "vim::InsertAfter",
      "shift-e": "vim::InsertEndOfLine",
      "m": ["vim::Matching", { "match_quotes": true }],
      "v": "vim::ToggleVisual",
      "p": ["vim::Paste", { "preserve_clipboard": true }],
      ":": "command_palette::Toggle",
      ";": "file_finder::Toggle",
      "'": "text_finder::Toggle",
      "\"": "outline::Toggle",
      "/": "buffer_search::Deploy",
      "g /": "pane::DeploySearch",
      "g .": "vim::ChangeListNewer",
      "g ,": "vim::ChangeListOlder",
      "g d": "editor::GoToDefinition",
      "g l": "editor::GoToDeclaration",
      "g y": "editor::GoToTypeDefinition",
      "g i": "editor::GoToImplementation",
      "g a": "editor::FindAllReferences",
      "g x": "editor::OpenUrl",
      "g v": "vim::RestoreVisualSelection",
      "g j": "vim::JoinLinesNoWhitespace",
      "g c": "vim::ToggleComments",
      "g b": "vim::ToggleBlockComments",
      "z a": "editor::ToggleFold",
      "z t": "editor::ScrollCursorTop",
      "z z": "editor::ScrollCursorCenter",
      "z b": "editor::ScrollCursorBottom",
      "z shift-t": "vim::WindowTop",
      "z shift-z": "vim::WindowMiddle",
      "z shift-b": "vim::WindowBottom",
      "home": "vim::StartOfDocument",
      "end": "vim::EndOfDocument",
      "pageup": "vim::PageUp",
      "pagedown": "vim::PageDown",
      "up": "vim::LineUp",
      "down": "vim::LineDown",
      "left": "vim::WrappingLeft",
      "right": "vim::WrappingRight",
      "h": "editor::Hover",
      "shift-h": "editor::BlameHover",
      "n": "vim::PushSneak",
      "shift-n": "vim::PushSneakBackward",
      "shift-s": ["vim::PushAddSurrounds", {}],
      "shift-c": ["vim::PushChangeSurrounds", {}],
      "shift-x": "vim::PushDeleteSurrounds",
      "shift-f": "vim::SelectLargerSyntaxNode",
      "shift-t": "vim::SelectSmallerSyntaxNode",
      "shift-i": "editor::SelectInsideDelimiters",
      "shift-a": "editor::SelectAroundDelimiters",
      "shift-v": "vim::ToggleVisualLine",
      "ctrl-v": "vim::ToggleVisualBlock"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "escape": "editor::Cancel",
      "y": "vim::PushYank",
      "x": "vim::PushDelete",
      "c": "vim::PushChange",
      "f": ["vim::PushFindForward", { "before": false, "multiline": true }],
      "t": ["vim::PushFindBackward", { "after": false, "multiline": true }],
      "u": "vim::Undo",
      "o": "vim::Redo",
      ".": "vim::RepeatFind",
      ",": "vim::RepeatFindReversed"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "escape": "vim::NormalBefore",
      "y": "vim::VisualYank",
      "x": "vim::VisualDelete",
      "c": "vim::Substitute",
      "f": "vim::SelectNext",
      "t": "vim::SelectPrevious",
      "u": "editor::UndoSelection",
      "o": "editor::RedoSelection",
      ".": "vim::OtherEndRowAware",
      ",": "vim::OtherEnd"
    }
  },
  {
    "context": "vim_mode == operator || vim_mode == waiting",
    "bindings": {
      "escape": "vim::ClearOperators",
      "i": ["vim::PushObject", { "around": false }],
      "a": ["vim::PushObject", { "around": true }]
    }
  },
  {
    "context": "vim_operator == y",
    "bindings": {
      "y": "vim::CurrentLine"
    }
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "x": "vim::CurrentLine"
    }
  },
  {
    "context": "vim_operator == c",
    "bindings": {
      "c": "vim::CurrentLine"
    }
  },
  {
    "context": "vim_operator == i || vim_operator == a || vim_operator == cs",
    "bindings": {
      "w": "vim::Word",
      "s": "vim::Subword",
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets",
      "'": "vim::Quotes",
      "`": "vim::BackQuotes",
      "\"": "vim::DoubleQuotes",
      "<": ["vim::AngleBrackets", { "opening": true }],
      ">": "vim::AngleBrackets",
      "{": ["vim::CurlyBrackets", { "opening": true }],
      "}": "vim::CurlyBrackets",
      "(": ["vim::Parentheses", { "opening": true }],
      ")": "vim::Parentheses",
      "[": ["vim::SquareBrackets", { "opening": true }],
      "]": "vim::SquareBrackets",
      "|": "vim::VerticalBars",
      "\\": "vim::Comment"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "escape": "vim::NormalBefore",
      "enter": "editor::Newline",
      "up": "editor::MoveUp",
      "down": "editor::MoveDown",
      "ctrl-shift-v": "editor::Paste",
      "alt-i": "editor::MoveUp",
      "alt-j": "editor::MoveLeft",
      "alt-k": "editor::MoveDown",
      "alt-l": "editor::MoveRight",
      "alt-u": "editor::Undo",
      "alt-o": "editor::Redo"
    }
  },
  {
    "context": "Editor && !VimControl",
    "bindings": {
      "left": "editor::MoveLeft",
      "right": "editor::MoveRight",
      "home": ["editor::MoveToBeginningOfLine", { "stop_at_indent": true }],
      "end": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": true }],
      "backspace": "editor::Backspace",
      "delete": "editor::Delete"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-enter": "editor::OpenSelectionsInMultibuffer",
      "alt-space": "editor::ShowCompletions",
      "alt-a": "editor::ToggleCodeActions",
      "alt-h": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "buffer_search_deployed > (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "n": "search::SelectNextMatch",
      "shift-n": "search::SelectPreviousMatch"
    }
  },
  {
    "context": "ProjectSearchView > (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "n": "search::SelectNextMatch",
      "shift-n": "search::SelectPreviousMatch"
    }
  },
  {
    "context": "diffs_expanded && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "n": "editor::GoToHunk",
      "shift-n": "editor::GoToPreviousHunk",
      "x": "git::ToggleStaged",
      "y": ["action::Sequence", ["git::ToggleStaged", "editor::GoToHunk"]],
      "u": ["action::Sequence", ["editor::GoToPreviousHunk", "git::ToggleStaged"]],
      "enter": "editor::OpenExcerpts",
      "shift-enter": "editor::OpenExcerptsSplit",
      "alt-enter": "git::Commit"
    }
  },
  {
    "context": "GitPanel && ChangesList",
    "bindings": {
      "enter": "menu::Confirm",
      "alt-enter": "menu::SecondaryConfirm",
      "i": "git_panel::PreviousEntry",
      "j": "git_panel::CollapseSelectedEntry",
      "k": "git_panel::NextEntry",
      "l": "git_panel::ExpandSelectedEntry",
      "g": "git_panel::FocusEditor",
      "c": "git_panel::ActivateChangesTab",
      "h": "git_panel::ActivateHistoryTab",
      "x": "git::ToggleStaged",
      "y": "git::StageAll",
      "u": "git::UnstageAll"
    }
  },
  {
    "context": "GitPanel && CommitEditor > (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "escape": "git::Cancel",
      "alt-enter": "git::Commit",
      "g": "git_panel::FocusChanges",
      "c": "git::ExpandCommitEditor",
      "h": "git::ToggleFillCommitEditor"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "enter": "project_panel::Open",
      "i": "vim::MenuSelectPrevious",
      "j": "project_panel::CollapseSelectedEntry",
      "k": "vim::MenuSelectNext",
      "l": "project_panel::ExpandSelectedEntry",
      "r": "project_panel::Rename",
      "e": "project_panel::CollapseAllEntries",
      "m": "project_panel::SelectParent",
      "v": "project_panel::CompareMarkedFiles",
      "p": "project_panel::Paste",
      "y": "project_panel::Copy",
      "x": ["project_panel::Trash", { "skip_prompt": true }],
      "c": "project_panel::Cut",
      "f": "project_panel::NewFile",
      "t": "project_panel::NewDirectory",
      "u": "project_panel::Undo",
      "o": "project_panel::Redo",
      "1": ["vim::Number", 1],
      "2": ["vim::Number", 2],
      "3": ["vim::Number", 3],
      "4": ["vim::Number", 4],
      "5": ["vim::Number", 5],
      "6": ["vim::Number", 6],
      "7": ["vim::Number", 7],
      "8": ["vim::Number", 8],
      "9": ["vim::Number", 9],
      "0": ["vim::Number", 0]
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "escape": ["terminal::SendKeystroke", "escape"],
      "enter": ["terminal::SendKeystroke", "enter"],
      "up": ["terminal::SendKeystroke", "up"],
      "down": ["terminal::SendKeystroke", "down"],
      "left": ["terminal::SendKeystroke", "left"],
      "right": ["terminal::SendKeystroke", "right"],
      "ctrl-z": ["terminal::SendKeystroke", "ctrl-z"],
      "ctrl-y": ["terminal::SendKeystroke", "ctrl-y"],
      "ctrl-c": ["terminal::SendKeystroke", "ctrl-c"],
      "ctrl-d": ["terminal::SendKeystroke", "ctrl-d"],
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-f": ["terminal::SendKeystroke", "ctrl-f"],
      "backspace": ["terminal::SendKeystroke", "backspace"],
      "delete": ["terminal::SendKeystroke", "delete"],
      "tab": ["terminal::SendKeystroke", "tab"],
      "shift-tab": ["terminal::SendKeystroke", "shift-tab"],
      "home": "terminal::ScrollToTop",
      "end": "terminal::ScrollToBottom",
      "pageup": "terminal::ScrollPageUp",
      "pagedown": "terminal::ScrollPageDown",
      "shift-up": "terminal::ScrollLineUp",
      "shift-down": "terminal::ScrollLineDown",
      "ctrl-k": "terminal::Clear",
      "ctrl-shift-c": "terminal::Copy",
      "ctrl-shift-v": "terminal::Paste"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "escape": "menu::Cancel",
      "enter": "menu::Confirm",
      "ctrl-o": "workspace::Open",
      "ctrl-h": "projects::OpenRecent",
      "ctrl-e": "search::FocusSearch",
      "alt-e": "editor::ToggleFocus",
      "alt-d": "workspace::ToggleRightDock",
      "alt-f": "project_panel::ToggleFocus",
      "alt-g": "git_panel::ToggleFocus",
      "alt-w": "git::Worktree",
      "alt-s": "git::ViewStash",
      "ctrl-d": "git::Diff",
      "ctrl-b": "git::Branch",
      "ctrl-g": "git_graph::Open",
      "alt-t": "terminal_panel::Toggle",
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-shift-t": "pane::ReopenClosedItem",
      "ctrl-u": "pane::RevealInProjectPanel",
      "ctrl-w": ["pane::CloseActiveItem", { "close_pinned": false }],
      "ctrl-s": "workspace::FormatAndSave",
      "ctrl-=": ["zed::IncreaseBufferFontSize", { "persist": false }],
      "ctrl--": ["zed::DecreaseBufferFontSize", { "persist": false }],
      "ctrl-0": ["zed::ResetBufferFontSize", { "persist": false }],
      "alt-1": ["pane::ActivateItem", 0],
      "alt-2": ["pane::ActivateItem", 1],
      "alt-3": ["pane::ActivateItem", 2],
      "alt-4": ["pane::ActivateItem", 3],
      "alt-5": ["pane::ActivateItem", 4],
      "alt-6": ["pane::ActivateItem", 5],
      "alt-7": ["pane::ActivateItem", 6],
      "alt-8": ["pane::ActivateItem", 7],
      "alt-9": "pane::ActivateLastItem",
      "alt-0": "workspace::ResetActiveDockSize",
      "alt-left": "pane::GoBack",
      "alt-right": "pane::GoForward",
      "tab": "workspace::ActivateNextPane",
      "shift-tab": "workspace::ActivatePreviousPane",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-pageup": "pane::ActivatePreviousItem",
      "ctrl-pagedown": "pane::ActivateNextItem",
      "ctrl-shift-pageup": "pane::SwapItemLeft",
      "ctrl-shift-pagedown": "pane::SwapItemRight"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "escape": "buffer_search::Dismiss",
      "enter": "search::SelectNextMatch",
      "shift-enter": "search::SelectPreviousMatch",
      "alt-enter": "search::SelectAllMatches",
      "up": "search::PreviousHistoryQuery",
      "down": "search::NextHistoryQuery"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "up": "menu::SelectPrevious",
      "down": "menu::SelectNext",
      "home": "menu::SelectFirst",
      "end": "menu::SelectLast",
      "tab": "menu::SelectNext",
      "shift-tab": "menu::SelectPrevious",
      "alt-space": "picker::TogglePreview",
      "alt-v": "picker::SetPreviewBelow",
      "alt-h": "picker::SetPreviewRight"
    }
  },
  {
    "context": "FileFinder || TextFinder",
    "bindings": {
      "alt-enter": "picker::ToggleActionsMenu",
      "shift-enter": "text_finder::ToProjectSearch"
    }
  },
  {
    "context": "CommandPalette",
    "bindings": {
      "alt-enter": "menu::SecondaryConfirm"
    }
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "ctrl-w": "tab_switcher::CloseSelectedItem"
    }
  },
  {
    "context": "GitPicker",
    "bindings": {
      "ctrl-b": "git_picker::ActivateBranchesTab",
      "alt-s": "git_picker::ActivateStashTab"
    }
  },
  {
    "context": "GitBranchSelector",
    "bindings": {
      "alt-enter": "menu::SecondaryConfirm",
      "alt-space": "branch_picker::CycleBranchFilter",
      "ctrl-backspace": "branch_picker::DeleteBranch",
      "ctrl-alt-backspace": "branch_picker::ForceDeleteBranch"
    }
  },
  {
    "context": "StashList",
    "bindings": {
      "ctrl-backspace": "stash_picker::DropStashItem",
      "ctrl-v": "stash_picker::ShowStashItem"
    }
  },
  {
    "context": "WorktreePicker",
    "bindings": {
      "ctrl-backspace": "worktree_picker::DeleteWorktree",
      "ctrl-alt-backspace": "worktree_picker::ForceDeleteWorktree"
    }
  },
  {
    "context": "RecentProjects",
    "bindings": {
      "alt-enter": "recent_projects::ToggleActionsMenu",
      "shift-enter": "recent_projects::AddToWorkspace",
      "ctrl-enter": "menu::SecondaryConfirm",
      "ctrl-backspace": "recent_projects::RemoveSelected"
    }
  },
  {
    "context": "Editor && (showing_completions || showing_code_actions)",
    "bindings": {
      "escape": "editor::Cancel",
      "up": "editor::ContextMenuPrevious",
      "down": "editor::ContextMenuNext",
      "home": "editor::ContextMenuFirst",
      "end": "editor::ContextMenuLast",
      "tab": "editor::ContextMenuNext",
      "shift-tab": "editor::ContextMenuPrevious"
    }
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "enter": "editor::ConfirmCompletion"
    }
  },
  {
    "context": "Editor && showing_code_actions",
    "bindings": {
      "enter": "editor::ConfirmCodeAction"
    }
  },
  {
    "context": "Editor && showing_signature_help",
    "bindings": {
      "up": "editor::SignatureHelpPrevious",
      "down": "editor::SignatureHelpNext"
    }
  },
  {
    "context": "MarkdownPreview",
    "bindings": {
      "escape": "markdown::CloseAndReturnToEditor",
      "home": "markdown::ScrollToTop",
      "end": "markdown::ScrollToBottom",
      "pageup": "markdown::ScrollPageUp",
      "pagedown": "markdown::ScrollPageDown",
      "up": "markdown::ScrollUp",
      "down": "markdown::ScrollDown"
    }
  },
  {
    "context": "!SettingsWindow",
    "bindings": {
      "ctrl-,": "zed::OpenSettings"
    }
  },
  {
    "context": "SettingsWindow > NavigationMenu",
    "bindings": {
      "up": "settings_editor::FocusPreviousNavEntry",
      "down": "settings_editor::FocusNextNavEntry",
      "left": "settings_editor::CollapseNavEntry",
      "right": "settings_editor::ExpandNavEntry",
      "home": "settings_editor::FocusFirstNavEntry",
      "end": "settings_editor::FocusLastNavEntry",
      "pageup": "settings_editor::FocusPreviousRootNavEntry",
      "pagedown": "settings_editor::FocusNextRootNavEntry",
      "tab": "settings_editor::FocusNextNavEntry",
      "shift-tab": "settings_editor::FocusPreviousNavEntry"
    }
  }
]
