{
  "edit_predictions": {
    "mode": "eager"
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "google",
      "model": "gemini-2.5-flash"
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash"
    },
    "model_parameters": []
  },
  "agent_buffer_font_size": 14,
  "autosave": "on_window_change",
  "base_keymap": "None",
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "buffer_font_family": "Geist Mono",
  "buffer_font_size": 14,
  "confirm_quit": false,
  "enable_language_server": true,
  "features": {
    "edit_prediction_provider": "supermaven"
  },
  "git": {
    "git_gutter": "hide"
  },
  "git_panel": {
    "default_width": 320
  },
  "icon_theme": "Zed (Default)",
  "node": {
    "path": "/home/rsp/packages/pnpm/node",
    "npm_path": "/home/rsp/packages/pnpm/npm",
    "ignore_system_version": true
  },
  "project_panel": {
    "default_width": 320,
    "dock": "right",
    "file_icons": false,
    "folder_icons": false,
    "hide_root": true
  },
  "restore_on_startup": "none",
  "scrollbar": {
    "diagnostics": "warning",
    "selected_symbol": false,
    "selected_text": false
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "terminal": {
    "blinking": "on",
    "cursor_shape": "bar",
    "font_family": "Geist Mono",
    "minimum_contrast": 0
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Midnight Shell Dark"
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "ui_font_family": "Geist",
  "ui_font_size": 14,
  "ui_font_weight": 400,
  "use_smartcase_search": true
}
