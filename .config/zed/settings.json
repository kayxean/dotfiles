{
  // General
  "when_closing_with_no_tabs": "keep_window_open",
  "on_last_window_closed": "quit_app",
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "cli_default_open_behavior": "existing_window",
  "default_open_behavior": "existing_window",
  "session": {
    "restore_unsaved_buffers": true
  },
  "restore_on_startup": "launchpad",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "auto_update": false,
  // Appearance
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ansi Dark"
  },
  "icon_theme": "Zed (Default)",
  "buffer_font_family": "Geist Mono",
  "buffer_font_size": 14,
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "ui_font_family": "Geist",
  "ui_font_size": 14,
  "ui_font_weight": 400,
  "ui_font_features": {
    "calt": false,
    "liga": false
  },
  "text_rendering_mode": "grayscale",
  "multi_cursor_modifier": "alt",
  "cursor_blink": true,
  "cursor_shape": "bar",
  "hide_mouse": "on_typing_and_action",
  "reduce_motion": "off",
  "unnecessary_code_fade": 0.2,
  "current_line_highlight": "none",
  "selection_highlight": false,
  "rounded_selection": true,
  "minimum_contrast_for_highlights": 0,
  "show_wrap_guides": false,
  // Keymap
  "base_keymap": "None",
  "vim_mode": true,
  "helix_mode": false,
  // Editor
  "autosave": "on_focus_change",
  "which_key": {
    "enabled": true,
    "delay_ms": 512
  },
  "double_click_in_multibuffer": "open",
  "expand_excerpt_lines": 8,
  "excerpt_context_lines": 4,
  "diff_view_style": "unified",
  "scroll_beyond_last_line": "off",
  "vertical_scroll_margin": 0,
  "hover_popover_enabled": true,
  "hover_popover_delay": 200,
  "hover_popover_sticky": true,
  "hover_popover_hiding_delay": 200,
  "drag_and_drop_selection": {
    "enabled": true,
    "delay": 200
  },
  "gutter": {
    "breakpoints": false,
    "bookmarks": false,
    "line_numbers": false,
    "runnables": false,
    "folds": false,
    "min_line_number_digits": 4
  },
  "relative_line_numbers": "enabled",
  "inline_code_actions": true,
  "scrollbar": {
    "git_diff": false,
    "show": "never"
  },
  "minimap": {
    "current_line_highlight": "all",
    "show": "never"
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "tab_size": 2,
  "hard_tabs": false,
  "auto_indent": "syntax_aware",
  "auto_indent_on_paste": true,
  "soft_wrap": "none",
  "indent_guides": {
    "enabled": false,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "format_on_save": "modifications_if_available",
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,
  "line_ending": "detect",
  "use_on_type_format": true,
  "use_autoclose": true,
  "use_auto_surround": true,
  "always_treat_brackets_as_autoclosed": true,
  "jsx_tag_auto_close": {
    "enabled": true
  },
  "show_whitespaces": "none",
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "completions": {
    "words": "disabled",
    "words_min_length": 2
  },
  "completion_detail_alignment": "right",
  "completion_menu_item_kind": "off",
  "inlay_hints": {
    "enabled": false,
    "show_background": false,
    "show_value_hints": false,
    "show_type_hints": false,
    "show_parameter_hints": false,
    "show_other_hints": false
  },
  "code_lens": "off",
  "lsp_document_colors": "inlay",
  "tasks": {
    "enabled": true,
    "prefer_lsp": false
  },
  "word_diff_enabled": true,
  "middle_click_paste": false,
  "extend_comment_on_newline": true,
  "colorize_brackets": false,
  "image_viewer": {
    "unit": "decimal"
  },
  "markdown_preview": {
    "max_width": 1024
  },
  "drop_target_size": 0.2,
  // Languages & Tools
  "enable_language_server": true,
  "linked_edits": true,
  "go_to_definition_fallback": "find_all_references",
  "go_to_definition_scroll_strategy": "center",
  "lsp_results_location": "multi_buffer",
  "semantic_tokens": "off",
  "debuggers": [],
  "prettier": {
    "allowed": false
  },
  "diagnostics": {
    "inline": {
      "enabled": false,
      "padding": 1,
      "min_column": 1
    },
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50
    }
  },
  "diagnostics_max_severity": "all",
  "lsp_highlight_debounce": 75,
  "lsp": {
    "rust-analyzer": {
      "enable_lsp_tasks": true,
      "initialization_options": {
        "diagnostics": {
          "experimental": { "enable": true }
        },
        "checkOnSave": false,
        "cargo": { "allTargets": false },
        "check": { "command": "clippy", "workspace": false },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": { "enable": "skip_trivial", "useParameterNames": true },
          "closureReturnTypeHints": { "enable": "always" }
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": { "fmt.configPath": null, "run": "onSave" }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "astro": "html",
          "svelte": "html",
          "vue": "html"
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class:list=\"{([^}]*)}\"",
            "class:list='{([^}]*)}'",
            "class:\\s*([^\\s{]+)",
            "\\{\\s*class:\\s*\"([^\"]*)\"",
            "\\{\\s*class:\\s*'([^']*)'",
            ":class=\"([^\"]*)\"",
            ":class='([^']*)'",
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]"
          ]
        }
      }
    },
    "bash-language-server": {
      "settings": {
        "bashIde": {
          "shellcheckPath": "shellcheck",
          "highlightParsingErrors": true
        }
      }
    }
  },
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer"],
      "formatter": { "language_server": { "name": "rust-analyzer" } }
    },
    "Lua": {
      "language_servers": ["lua-language-server", "color-lsp"],
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "TypeScript": {
      "language_servers": ["typescript-ls", "oxfmt", "oxlint"],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "oxfmt", "oxlint"],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "JavaScript": {
      "language_servers": ["typescript-ls", "oxfmt", "oxlint"],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "Markdown": {
      "language_servers": ["oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "MDX": {
      "language_servers": ["mdx-analyzer", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Astro": {
      "language_servers": ["astro-language-server", "oxfmt", "oxlint"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Svelte": {
      "language_servers": ["svelte-language-server", "oxfmt", "oxlint"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Vue.js": {
      "language_servers": ["vue-language-server", "oxfmt", "oxlint"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "HTML": {
      "language_servers": ["vscode-html-language-server", "emmet-language-server", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "CSS": {
      "language_servers": [
        "vscode-css-language-server",
        "emmet-language-server",
        "color-lsp",
        "oxfmt"
      ],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSON": {
      "language_servers": ["json-language-server", "color-lsp", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "language_servers": ["json-language-server", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TOML": {
      "language_servers": ["tombi", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "language_servers": ["yaml-language-server", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Shell Script": {
      "tab_size": 2,
      "language_servers": ["bash-language-server"],
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"]
        }
      }
    }
  },
  "node": {
    "path": "/usr/bin/node",
    "npm_path": "/usr/bin/npm",
    "ignore_system_version": false
  },
  // Search & Files
  "search": {
    "button": true,
    "whole_word": false,
    "case_sensitive": false,
    "include_ignored": false,
    "regex": false,
    "center_on_match": true
  },
  "use_smartcase_search": false,
  "seed_search_query_from_cursor": "selection",
  "file_finder": {
    "include_ignored": "smart",
    "file_icons": true,
    "skip_focus_for_active_in_search": true
  },
  "close_on_file_delete": true,
  // Window & Layout
  "status_bar": {
    "experimental.show": false
  },
  "title_bar": {
    "show_branch_status_icon": false,
    "show_branch_name": true,
    "show_worktree_name": true,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_sign_in": true,
    "show_user_menu": true,
    "show_user_picture": true,
    "show_menus": false,
    "button_layout": "platform_default"
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_project_panel": false,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_file_from_code_navigation": false
  },
  "window_decorations": "server",
  "focus_follows_mouse": {
    "enabled": true
  },
  // Panels
  "close_panel_on_toggle": true,
  "project_panel": {
    "button": false,
    "dock": "right",
    "default_width": 320,
    "file_icons": false,
    "folder_indicator": "chevron",
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "sticky_scroll": false,
    "hide_root": true,
    "hide_gitignore": false
  },
  "terminal": {
    "button": false,
    "dock": "right",
    "cursor_shape": "bar",
    "blinking": "on",
    "copy_on_select": true,
    "font_features": {
      "calt": false,
      "liga": false
    },
    "minimum_contrast": 0,
    "shell": {
      "program": "/bin/zsh"
    }
  },
  "outline_panel": {
    "button": false,
    "dock": "right",
    "default_width": 320
  },
  "git_panel": {
    "sort_by": "path",
    "button": false,
    "dock": "right",
    "default_width": 320,
    "folder_indicator": "chevron",
    "file_icons": false,
    "tree_view": true,
    "group_by": "none",
    "collapse_untracked_diff": true
  },
  "debugger": {
    "button": false,
    "dock": "right"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
    "default_width": 320
  },
  "agent": {
    "button": false,
    "dock": "right",
    "default_width": 320,
    "limit_content_width": false,
    "flexible": true
  },
  // Version Control
  "git": {
    "enable_status": true,
    "enable_diff": true,
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false,
      "padding": 1
    }
  },
  // AI
  "disable_ai": true,
  "show_edit_predictions": false,
  "edit_predictions": {
    "mode": "subtle",
    "allow_data_collection": "no"
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "effort": "max",
        "mode": "plan",
        "model": "opencode/deepseek-v4-flash-free"
      },
      "type": "registry"
    }
  }
}
