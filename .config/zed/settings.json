{
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": false
    },
    "mode": "subtle",
    "provider": "zed"
  },
  "completions": {
    "words": "enabled",
    "words_min_length": 2,
    "lsp": true,
    "lsp_fetch_timeout_ms": 0,
    "lsp_insert_mode": "replace_subsequence"
  },

  "use_smartcase_search": true,
  "auto_signature_help": true,
  "multi_cursor_modifier": "alt",
  "code_lens": "on",
  "formatter": "language_server",
  "lsp_highlight_debounce": 50,
  "prettier": {
    "allowed": false
  },

  "base_keymap": "None",
  "hide_mouse": "on_typing",
  "autosave": "on_focus_change",
  "load_direnv": "disabled",
  "restore_on_startup": "launchpad",
  "cli_default_open_behavior": "existing_window",
  "confirm_quit": false,
  "close_panel_on_toggle": true,

  "hover_popover_sticky": true,
  "hover_popover_delay": 50,
  "hover_popover_hiding_delay": 200,
  "drag_and_drop_selection": {
    "enabled": true,
    "delay": 200
  },

  "agent_buffer_font_size": 14,
  "agent_ui_font_size": 14,
  "ui_font_family": "Geist",
  "ui_font_size": 14,
  "ui_font_weight": 400,
  "buffer_font_family": "Geist Mono",
  "buffer_font_size": 14,
  "buffer_line_height": "comfortable",
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "icon_theme": "Zed (Default)",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Midnight Shell Dark"
  },

  "window_decorations": "server",
  "title_bar": {
    "show_branch_status_icon": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false
  },
  "tabs": {
    "activate_on_close": "history",
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": false
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "file_finder": {
    "modal_max_width": "small",
    "include_channels": true
  },
  "search": {
    "regex": true,
    "button": true,
    "center_on_match": true,
    "include_ignored": false
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true,
    "experimental.show": true
  },
  "scrollbar": {
    "git_diff": false
  },

  "git": {
    "git_gutter": "tracked_files",
    "hunk_style": "unstaged_hollow"
  },
  "git_panel": {
    "status_style": "icon",
    "collapse_untracked_diff": true,
    "tree_view": true,
    "show_count_badge": true,
    "dock": "right",
    "default_width": 320,
    "folder_icons": false
  },
  "project_panel": {
    "button": true,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "default_width": 320,
    "dock": "right",
    "file_icons": false,
    "folder_icons": false,
    "hide_root": true
  },
  "outline_panel": {
    "dock": "right",
    "button": true,
    "default_width": 320
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false,
    "default_width": 320
  },
  "debugger": {
    "dock": "right",
    "button": false
  },
  "terminal": {
    "button": false,
    "blinking": "on",
    "cursor_shape": "bar",
    "font_family": "Geist Mono",
    "minimum_contrast": 0,
    "copy_on_select": true
  },
  "agent": {
    "default_model": {
      "provider": "google",
      "model": "gemini-3-flash-preview",
      "enable_thinking": false
    },
    "default_profile": "ask",
    "profiles": {
      "write": {
        "name": "Write",
        "enable_all_context_servers": true,
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "edit_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_directory": true,
          "project_notifications": false,
          "move_path": true,
          "now": true,
          "rename_symbol": true,
          "read_file": true,
          "restore_file_from_disk": true,
          "save_file": true,
          "open": true,
          "grep": true,
          "spawn_agent": true,
          "terminal": true,
          "thinking": true,
          "update_plan": true,
          "search_web": true
        }
      },
      "ask": {
        "name": "Ask",
        "tools": {
          "diagnostics": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": false,
          "now": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "read_file": true,
          "open": true,
          "grep": true,
          "spawn_agent": true,
          "thinking": true,
          "update_plan": true,
          "search_web": true
        }
      }
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            { "pattern": "^bun\\s" },
            { "pattern": "^vp\\s" },
            { "pattern": "^cargo\\s" }
          ],
          "always_deny": [
            { "pattern": "^sudo\\s" },
            { "pattern": "^sudo\\s+-pacman\\s" },
            { "pattern": "^paru\\s" },
            { "pattern": "^systemctl\\s" },
            { "pattern": "^rm\\s+-rf\\s+/" },
            { "pattern": "^npm\\s" },
            { "pattern": "^npx\\s" }
          ]
        },
        "edit_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/etc/" },
            { "pattern": "^/usr/" },
            { "pattern": "^/boot/" },
            { "pattern": "^/var/" },
            { "pattern": "\\.env" },
            { "pattern": "secrets?/" },
            { "pattern": "\\.(pem|key)$" }
          ]
        },
        "delete_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/etc/" },
            { "pattern": "^/usr/" },
            { "pattern": "^/boot/" },
            { "pattern": "^/var/" },
            { "pattern": "\\.git/?$" },
            { "pattern": "node_modules/?$" }
          ]
        },
        "copy_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/etc/" },
            { "pattern": "^/usr/" },
            { "pattern": "^/boot/" },
            { "pattern": "^/var/" }
          ]
        },
        "move_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/etc/" },
            { "pattern": "^/usr/" },
            { "pattern": "^/boot/" },
            { "pattern": "^/var/" },
            { "pattern": "\\.git/?$" },
            { "pattern": "node_modules/?$" }
          ]
        },
        "create_directory": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/etc/" },
            { "pattern": "^/usr/" },
            { "pattern": "^/boot/" },
            { "pattern": "^/var/" }
          ]
        },
        "save_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/etc/" },
            { "pattern": "^/usr/" },
            { "pattern": "^/boot/" },
            { "pattern": "^/var/" },
            { "pattern": "\\.env" },
            { "pattern": "secrets?/" },
            { "pattern": "\\.(pem|key)$" }
          ]
        },
        "restore_file_from_disk": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/etc/" },
            { "pattern": "^/usr/" },
            { "pattern": "^/boot/" },
            { "pattern": "^/var/" }
          ]
        },
        "fetch": {
          "default": "allow",
          "always_deny": [
            { "pattern": "localhost" },
            { "pattern": "127\\.0\\.0\\.1" },
            { "pattern": "10\\.\\d+\\.\\d+\\.\\d+" },
            { "pattern": "192\\.168\\.\\d+\\.\\d+" },
            { "pattern": "169\\.254\\.\\d+\\.\\d+" }
          ]
        },
        "search_web": {
          "default": "allow"
        }
      }
    },
    "single_file_review": true,
    "enable_feedback": false,
    "inline_assistant_use_streaming_tools": false,
    "enabled": true,
    "default_width": 768,
    "max_content_width": 768,
    "dock": "left",
    "sidebar_side": "left",
    "flexible": false,
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "thinking_display": "always_expanded"
  },

  "agent_servers": {
    "qwen-code": {
      "type": "registry"
    },
    "kimi": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "nova": {
      "type": "registry"
    },
    "mistral-vibe": {
      "type": "registry"
    },
    "kilo": {
      "type": "registry"
    },
    "junie": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "codebuddy-code": {
      "type": "registry"
    }
  },

  "diagnostics": {
    "button": false,
    "include_warnings": true,
    "inline": { "enabled": true, "update_debounce_ms": 50 },
    "lsp_pull_diagnostics": {
      "debounce_ms": 50
    }
  },

  "languages": {
    "CSS": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "language_servers": ["tailwindcss-language-server"]
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "enable_language_server": false
    },
    "JavaScript": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ],
      "language_servers": ["tsgo", "..."]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "language_servers": ["json-language-server"]
    },
    "JSON5": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "show_edit_predictions": false,
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "language_servers": ["json-language-server"]
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "enable_language_server": false
    },
    "TypeScript": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "language_servers": ["tsgo", "..."]
    },
    "TSX": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "language_servers": ["tsgo", "..."]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Lua": {
      "format_on_save": "on",
      "formatter": "language_server",
      "language_servers": ["lua-language-server"]
    },
    "Python": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "ruff" } }],
      "language_servers": ["basedpyright", "ruff"]
    },
    "Nix": {
      "language_servers": ["nil", "nixd"]
    },
    "Shell Script": {
      "language_servers": ["bash-language-server"]
    }
  },

  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny",
          "typeAware": true
        }
      },
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/extensions/work/oxc/node_modules/oxlint/bin/oxlint",
          "--lsp"
        ]
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave",
          "typeAware": true
        }
      },
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/extensions/work/oxc/node_modules/oxfmt/bin/oxfmt",
          "--lsp"
        ]
      }
    },
    "tsgo": {
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/extensions/work/tsgo/node_modules/@typescript/native-preview/bin/tsgo.js",
          "--lsp",
          "--stdio"
        ]
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": { "enabled": "always" }
        },
        "javascript": {
          "updateImportsOnFileMove": { "enabled": "always" }
        }
      },
      "enable_lsp_tasks": true,
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/languages/vtsls/node_modules/@vtsls/language-server/bin/vtsls.js",
          "--stdio"
        ]
      }
    },
    "eslint": {
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/languages/eslint/vscode-eslint-3.0.24/vscode-eslint/server/out/eslintServer.js",
          "--stdio"
        ]
      }
    },
    "tailwindcss-language-server": {
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/languages/tailwindcss-language-server/node_modules/@tailwindcss/language-server/bin/tailwindcss-language-server",
          "--stdio"
        ]
      }
    },
    "rust-analyzer": {
      "binary": {
        "path": "/home/rsp/.cache/cargo/bin/rust-analyzer",
        "arguments": [],
        "ignore_system_version": true
      },
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    },
    "lua-language-server": {
      "binary": {
        "path": "/home/rsp/.local/share/zed/extensions/work/lua/lua-language-server-3.18.2/bin/lua-language-server"
      }
    },
    "nil": {
      "binary": {
        "path": "/home/rsp/.nix-profile/bin/nil"
      }
    },
    "nixd": {
      "binary": {
        "path": "/home/rsp/.nix-profile/bin/nixd"
      }
    },
    "gopls": {
      "binary": {
        "path": "/home/rsp/.nix-profile/bin/gopls",
        "ignore_system_version": true
      }
    },
    "ruff": {
      "binary": {
        "path": "/home/rsp/.local/share/zed/languages/ruff/ruff-0.15.14/ruff-x86_64-unknown-linux-gnu/ruff",
        "arguments": ["server"]
      }
    },
    "basedpyright": {
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/languages/basedpyright/node_modules/.bin/basedpyright-langserver",
          "--stdio"
        ]
      }
    },
    "json-language-server": {
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/languages/json-language-server/node_modules/vscode-langservers-extracted/bin/vscode-json-language-server",
          "--stdio"
        ]
      }
    },
    "bash-language-server": {
      "binary": {
        "path": "/home/rsp/.cache/vite-plus/bin/node",
        "arguments": [
          "/home/rsp/.local/share/zed/languages/bash-language-server/node_modules/bash-language-server/out/cli.js",
          "start"
        ]
      }
    }
  },

  "node": {
    "path": "/home/rsp/.local/bin/sandbox-node",
    "npm_path": "/home/rsp/.local/bin/sandbox-npm",
    "ignore_system_version": true
  }
}
