{
  "proxy": "",
  "cli_default_open_behavior": "existing_window",
  "base_keymap": "None",
  "hide_mouse": "on_typing",
  "always_treat_brackets_as_autoclosed": true,
  "close_panel_on_toggle": true,
  "document_folding_ranges": "on",
  "show_signature_help_after_edits": true,

  "autosave": "on_focus_change",
  "restore_on_startup": "launchpad",
  "confirm_quit": false,

  "prettier": {
    "allowed": false
  },

  "linux": {},

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Midnight Shell Dark"
  },
  "icon_theme": "Zed (Default)",

  "ui_font_family": "Geist",
  "ui_font_size": 14,
  "ui_font_weight": 400,

  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "buffer_font_family": "Geist Mono",
  "buffer_font_size": 14,
  "buffer_line_height": "comfortable",

  "agent_buffer_font_size": 14,

  "terminal": {
    "button": false,
    "blinking": "on",
    "cursor_shape": "bar",
    "font_family": "Geist Mono",
    "minimum_contrast": 0
  },

  "project_panel": {
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "default_width": 320,
    "dock": "right",
    "file_icons": false,
    "folder_icons": false,
    "hide_root": true
  },

  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },

  "search": {
    "center_on_match": true,
    "include_ignored": true
  },
  "use_smartcase_search": true,

  "drag_and_drop_selection": {
    "enabled": true,
    "delay": 300
  },

  "hover_popover_sticky": true,
  "hover_popover_delay": 50,
  "hover_popover_hiding_delay": 100,

  "scroll_beyond_last_line": "vertical_scroll_margin",
  "scrollbar": {
    "git_diff": false,
    "diagnostics": "warning"
  },

  "git_panel": {
    "status_style": "icon",
    "collapse_untracked_diff": true,
    "tree_view": true,
    "show_count_badge": true,
    "dock": "left",
    "default_width": 320
  },
  "git": {
    "git_gutter": "tracked_files",
    "hunk_style": "unstaged_hollow"
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 320
  },

  "status_bar": {
    "experimental.show": true
  },

  "node": {
    "path": "/home/rsp/.vite-plus/bin/node",
    "npm_path": "/home/rsp/.vite-plus/bin/npm",
    "ignore_system_version": true
  },

  "agent": {
    "enabled": true,
    "default_width": 480,
    "dock": "right",
    "sidebar_side": "right",
    "flexible": false,
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^cargo\\s+(build|test|check|clippy|fmt)" },
            { "pattern": "^npm\\s+(install|test|run|build)" },
            { "pattern": "^git\\s+(status|log|diff|branch)" },
            { "pattern": "^ls\\b" },
            { "pattern": "^cat\\s" }
          ],
          "always_deny": [{ "pattern": "rm\\s+-rf\\s+(/|~)" }, { "pattern": "sudo\\s+rm" }],
          "always_confirm": [{ "pattern": "sudo\\s" }, { "pattern": "git\\s+push" }]
        },
        "edit_file": {
          "default": "confirm",
          "always_allow": [{ "pattern": "\\.(md|txt|json)$" }, { "pattern": "^src/" }],
          "always_deny": [
            { "pattern": "\\.env" },
            { "pattern": "secrets?/" },
            { "pattern": "\\.(pem|key)$" }
          ]
        },
        "delete_path": {
          "default": "confirm",
          "always_deny": [
            { "pattern": "^/etc" },
            { "pattern": "^/usr" },
            { "pattern": "\\.git/?$" },
            { "pattern": "node_modules/?$" }
          ]
        }
      }
    }
  },

  "agent_servers": {
    "gemini": {
      "default_mode": "yolo",
      "favorite_models": ["gemini-3-flash-preview", "gemini-3.1-flash-lite-preview"],
      "type": "registry"
    },
    "opencode": {
      "favorite_config_option_values": {
        "model": [
          "github-copilot/claude-haiku-4.5",
          "opencode/hy3-preview-free",
          "openrouter/google/gemma-4-31b-it",
          "openrouter/google/gemma-4-31b-it:free",
          "openrouter/google/gemma-4-26b-a4b-it",
          "openrouter/google/gemma-4-26b-a4b-it:free"
        ]
      },
      "type": "registry"
    }
  },

  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": false
    },
    "mode": "subtle",
    "provider": "zed"
  },
  "edit_predictions_disabled_in": ["comment"],

  "completions": {
    "words": "enabled",
    "words_min_length": 2,
    "lsp": true,
    "lsp_fetch_timeout_ms": 0,
    "lsp_insert_mode": "replace_subsequence"
  },

  "enable_language_server": true,
  "semantic_tokens": "combined",

  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path": "/home/rsp/.cargo/bin/rust-analyzer",
        "arguments": [],
        "ignore_system_version": true
      },
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": { "enabled": "always" }
        },
        "javascript": {
          "updateImportsOnFileMove": { "enabled": "always" }
        }
      },
      "enable_lsp_tasks": true
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny",
          "typeAware": true
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave",
          "typeAware": true
        }
      }
    }
  },
  "languages": {
    "CSS": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JavaScript": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSON5": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "show_edit_predictions": false,
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TypeScript": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TSX": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  },

  "diagnostics": {
    "include_warnings": true,
    "inline": { "enabled": true },
    "lsp_pull_diagnostics": {
      "debounce_ms": 300
    }
  }
}
