{
  "base_keymap": "None",
  "vim_mode": true,
  "command_aliases": {
    "join": "pane::JoinAll",
    "swap": "workspace::SwapPaneAdjacent",
    "split": "workspace::MoveItemToPaneInDirection",
    "alt": "pane::AlternateFile"
  },
  "disable_ai": true,
  "auto_update": false,
  "node": {
    "path": "/home/dev/.local/share/pnpm/bin/node",
    "npm_path": "/home/dev/.local/share/pnpm/bin/npm",
    "ignore_system_version": false
  },
  "git": {
    "inline_blame": {
      "enabled": false,
      "padding": 1
    },
    "git_gutter": "hide"
  },
  "git_panel": {
    "dock": "right",
    "default_width": 320,
    "collapse_untracked_diff": true
  },
  "project_panel": {
    "dock": "right",
    "default_width": 320,
    "file_icons": false,
    "folder_icons": false,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "sticky_scroll": false
  },
  "terminal": {
    "dock": "right",
    "cursor_shape": "bar",
    "blinking": "on",
    "copy_on_select": true,
    "font_features": { "calt": false, "liga": false },
    "minimum_contrast": 0
  },
  "debugger": {
    "dock": "right"
  },
  "status_bar": {
    "experimental.show": false
  },
  "title_bar": {
    "show_onboarding_banner": false
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "preview_tabs": {
    "enabled": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "outline_panel": {
    "dock": "right",
    "default_width": 320
  },
  "collaboration_panel": {
    "dock": "right",
    "default_width": 320
  },
  "agent": {
    "dock": "right",
    "default_width": 320,
    "limit_content_width": false,
    "flexible": true,
    "sidebar_side": "right"
  },
  "close_panel_on_toggle": true,
  "close_on_file_delete": true,
  "extend_comment_on_newline": false,
  "seed_search_query_from_cursor": "selection",
  "focus_follows_mouse": { "enabled": true },
  "gutter": {
    "min_line_number_digits": 3,
    "runnables": false,
    "folds": false
  },
  "scrollbar": { "show": "never" },
  "relative_line_numbers": "enabled",
  "soft_wrap": "none",
  "vertical_scroll_margin": 0,
  "scroll_beyond_last_line": "off",
  "show_whitespaces": "none",
  "current_line_highlight": "none",
  "reduce_motion": "on",
  "buffer_font_features": { "calt": false, "liga": false },
  "buffer_line_height": "comfortable",
  "buffer_font_family": "Geist Mono",
  "ui_font_family": "Geist",
  "buffer_font_size": 14,
  "ui_font_size": 14,
  "theme": "Midnight Shell Dark",
  "auto_install_extensions": {
    "tsgo": true,
    "deno": true,
    "lua": true,
    "oxc": true,
    "mdx": true,
    "astro": true,
    "svelte": true,
    "vue": true,
    "html": true,
    "toml": true,
    "elisp": true
  },
  "lsp": {
    "rust-analyzer": {
      "enable_lsp_tasks": true,
      "initialization_options": {
        "diagnostics": {
          "experimental": { "enable": true }
        },
        "checkOnSave": false,
        "cargo": { "allTargets": false },
        "check": {
          "command": "clippy",
          "workspace": false
        },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": { "enable": "always" }
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    },
    "typescript-ls": {
      "settings": {
        "typescript": {
          "inlayHints": {
            "parameterNames": { "enabled": "all", "suppressWhenArgumentMatchesName": false },
            "parameterTypes": { "enabled": true },
            "variableTypes": { "enabled": true, "suppressWhenTypeMatchesName": true },
            "propertyDeclarationTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
            "enumMemberValues": { "enabled": true }
          },
          "implementationsCodeLens": {
            "enabled": true,
            "showOnAllClassMethods": true,
            "showOnInterfaceMethods": true
          },
          "referencesCodeLens": { "enabled": true, "showOnAllFunctions": true }
        },
        "javascript": {
          "inlayHints": {
            "parameterNames": { "enabled": "all", "suppressWhenArgumentMatchesName": false },
            "parameterTypes": { "enabled": true },
            "variableTypes": { "enabled": true, "suppressWhenTypeMatchesName": true },
            "propertyDeclarationTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
            "enumMemberValues": { "enabled": true }
          },
          "implementationsCodeLens": {
            "enabled": true,
            "showOnAllClassMethods": true,
            "showOnInterfaceMethods": true
          },
          "referencesCodeLens": { "enabled": true, "showOnAllFunctions": true }
        }
      }
    },
    "mdx-analyzer": {
      "initialization_options": {
        "typescript": {
          "enabled": true
        }
      }
    },
    "astro-language-server": {
      "settings": {
        "astro": {
          "format": {
            "enable": true,
            "indentFrontmatter": true
          }
        }
      }
    },
    "svelte-language-server": {
      "initialization_options": {
        "configuration": {
          "typescript": {
            "inlayHints": {
              "parameterNames": { "enabled": "all", "suppressWhenArgumentMatchesName": false },
              "parameterTypes": { "enabled": true },
              "variableTypes": { "enabled": true, "suppressWhenTypeMatchesName": true },
              "propertyDeclarationTypes": { "enabled": true },
              "functionLikeReturnTypes": { "enabled": true },
              "enumMemberValues": { "enabled": true }
            }
          }
        }
      }
    },
    "vue-language-server": {
      "settings": {
        "vue": {
          "inlayHints": {
            "inlineHandlerLeading": true,
            "missingProps": true,
            "optionsWrapper": true,
            "vBindShorthand": true
          }
        }
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": { "enabled": "always" }
        },
        "javascript": {
          "updateImportsOnFileMove": { "enabled": "always" }
        }
      }
    },
    "vscode-html-language-server": {
      "settings": {
        "html": {
          "format": {
            "indentInnerHtml": true,
            "wrapLineLength": 120,
            "preserveNewLines": true,
            "extraLiners": "head,body,/html"
          }
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": ["class=\"([^\"]*)\""]
        }
      }
    },
    "eslint": {
      "settings": {
        "rulesCustomizations": [{ "rule": "*", "severity": "warn" }],
        "problems": {
          "shortenToSingleLine": true
        }
      }
    },
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
          "lint": true,
          "unstable": false
        }
      }
    },
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": ["deno.json", "deno.jsonc"],
              "url": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json"
            }
          ]
        }
      }
    },
    "bash-language-server": {
      "settings": {
        "bashIde": {
          "shellcheckPath": "shellcheck",
          "highlightParsingErrors": true
        }
      }
    }
  },
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer", "..."],
      "formatter": { "language_server": { "name": "rust-analyzer" } }
    },
    "Lua": {
      "language_servers": ["lua-language-server"],
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "TypeScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "JavaScript": {
      "language_servers": ["deno", "!vtsls", "!typescript-language-server", "!eslint"],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "Markdown": {
      "language_servers": ["oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "MDX": {
      "language_servers": ["oxfmt", "mdx-analyzer", "..."],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Astro": {
      "language_servers": ["oxfmt", "astro-language-server", "..."],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Svelte": {
      "language_servers": ["oxfmt", "svelte-language-server", "..."],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Vue.js": {
      "language_servers": ["oxfmt", "vue-language-server", "..."],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "HTML": {
      "language_servers": ["oxfmt", "vscode-html-language-server", "..."],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "CSS": {
      "language_servers": ["oxfmt", "..."],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSON": {
      "language_servers": ["oxfmt", "json-language-server"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "language_servers": ["oxfmt", "json-language-server"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TOML": {
      "language_servers": ["oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "language_servers": ["oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Shell Script": {
      "tab_size": 2,
      "language_servers": ["bash-language-server", "..."],
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"]
        }
      }
    }
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  }
}
