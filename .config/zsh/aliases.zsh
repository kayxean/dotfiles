alias now="date +'%I:%M %p, %a, %b %d'"

alias view="bat --style=plain"
alias help="bat --language=help --style=plain"

alias chrome="google-chrome-stable"

alias z="__zoxide_z"
alias zi="__zoxide_zi"

alias ll="eza --across --group-directories-first --classify=auto --recurse"
alias li="eza --across --group-directories-first --classify=auto --recurse --tree"
alias ls="eza --all --across --group-directories-first --classify=auto"
alias la="eza --all --across --group-directories-first --classify=auto --long --git --git-repos-no-status --time-style='relative' --total-size"
