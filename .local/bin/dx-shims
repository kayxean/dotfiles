#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/dx-lib"

files() {
  cd "$(dx_root)"
  find . \
    \( -path ./.git -o -path ./pkg -o -path ./src -o -type d -name node_modules \) -prune -o \
    -type f \
    ! -name '*.sh' ! -name '*.md' ! -name '*.lock' ! -name '.pkglist' \
    ! -name 'PKGBUILD' ! -name '.gitignore' ! -name '*.zwc' ! -name '*.pkg.tar.*' \
    -print
}

cmd_update() {
  local f target rel
  while read -r f; do
    f="${f#./}"
    target="$HOME/$f"
    mkdir -p "$(dirname "$target")"
    rel="$(realpath --relative-to="$(dirname "$target")" "$(dx_root)/$f")"
    ln -sfn "$rel" "$target"
  done < <(files)
}

cmd_remove() {
  find "$HOME" -type l -print0 | while IFS= read -r -d '' l; do
    case "$(readlink -f "$l")" in
    "$(dx_root)"/*) rm "$l" ;;
    esac
  done
}

cmd_check() {
  local ok=0 missing=0 conflict=0
  while read -r f; do
    f="${f#./}"
    if [[ "$(readlink -f "$HOME/$f" 2>/dev/null)" == "$(readlink -f "$(dx_root)/$f")" ]]; then
      ok=$((ok + 1))
    elif [[ -e "$HOME/$f" || -L "$HOME/$f" ]]; then
      conflict=$((conflict + 1))
    else
      missing=$((missing + 1))
    fi
  done < <(files)

  echo "$ok ok, $missing missing, $conflict conflict"
  [[ $conflict -eq 0 && $missing -eq 0 ]]
}

case "${1:-}" in
check) cmd_check ;;
update) cmd_update ;;
remove) cmd_remove ;;
*)
  echo "error: unknown command '${1:-}'" >&2
  exit 1
  ;;
esac
