#!/usr/bin/env zsh
set -euo pipefail
exec bwrap \
  --ro-bind /nix /nix \
  --ro-bind /usr /usr \
  --ro-bind /etc /etc \
  --symlink usr/lib /lib \
  --symlink usr/lib64 /lib64 \
  --symlink usr/bin /bin \
  --proc /proc \
  --dev /dev \
  --dir /tmp \
  --bind "$(pwd)" "$(pwd)" \
  --chdir "$(pwd)" \
  --unshare-all --share-net --die-with-parent \
  --setenv HOME "$HOME" \
  --setenv PATH "$HOME/.cache/vite-plus/bin:/usr/bin" \
  --setenv NPM_CONFIG_CACHE "$HOME/.cache/npm" \
  --bind "$HOME/.cache/vite-plus" "$HOME/.cache/vite-plus" \
  --bind "$HOME/.cache/npm" "$HOME/.cache/npm" \
  "$HOME/.cache/vite-plus/bin/npx" "$@"
