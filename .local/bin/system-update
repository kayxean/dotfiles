#!/usr/bin/env zsh
set -euo pipefail

R=$(tput setaf 1)
G=$(tput setaf 2)
Y=$(tput setaf 3)
B=$(tput setaf 4)
M=$(tput setaf 5)
C=$(tput setaf 6)
W=$(tput setaf 7)
A=$(tput setaf 8)
N=$(tput sgr0)

dotfiles="$HOME/.local/dotfiles"
scriptname="${0##*/}"

usage() {
  cat <<EOF
${W}Usage:${N} ${G}$scriptname${N} ${A}<command>${N}

${W}Commands:${N}
  ${M}os${N}   ${W}Update system packages (pacman + paru) and cleanup${N}
  ${C}nix${N}  ${W}Update Nix development profile${N}
  ${G}all${N}  ${W}Run os and nix sequentially${N}
EOF
}

cmd_os() {
  echo "${C}==> system-update:${N} os"

  echo "  ${G}updating${N}: packages (paru)"
  paru -Syu --needed --cleanafter
  echo "  ${C}ok${N}"

  echo "  ${G}removing${N}: orphaned packages"
  if pacman -Qtdq | grep -q .; then
    pacman -Qtdq | xargs -r sudo pacman -Rns --noconfirm
    echo "  ${C}ok${N}"
  else
    echo "  ${Y}none${N}"
  fi

  echo "  ${G}cleaning${N}: partial downloads"
  sudo rm -rf /var/cache/pacman/pkg/download-*(N)
  echo "  ${C}ok${N}"

  echo "  ${G}cleaning${N}: pacman cache (keep 2)"
  sudo paccache -r -k 2
  echo "  ${C}ok${N}"

  echo "  ${G}vacuuming${N}: journal (7 days)"
  sudo journalctl --vacuum-time=7d
  echo "  ${C}ok${N}"

  echo "  ${G}exporting${N}: package list"
  {
    pacman -Qneq
    echo
    paru -Qmq
  } >"$dotfiles/.pkglist"
  echo "  ${C}ok${N}"
}

cmd_nix() {
  echo "${C}==> system-update:${N} nix"

  echo "  ${G}updating${N}: dotfiles profile"
  nix profile upgrade dotfiles
  echo "  ${C}ok${N}"

  echo "  ${G}cleaning${N}: nix store"
  nix store gc
  echo "  ${C}ok${N}"
}

cmd_all() {
  cmd_os
  cmd_nix
}

main() {
  case "${1:-}" in
    os)   cmd_os; exit $? ;;
    nix)  cmd_nix; exit $? ;;
    all)  cmd_all; exit $? ;;
    "")   usage; exit 0 ;;
    *)    echo "${R}error:${N} unknown command '$1'" >&2; exit 1 ;;
  esac
}

main "$@"
